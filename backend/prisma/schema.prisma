// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum BookingStatus {
  PENDING
  ASSIGNED
  ON_THE_WAY
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum MechanicStatus {
  AVAILABLE
  ON_JOB
  OFF_DUTY
}

model Customer {
  id        String    @id @default(cuid())
  name      String
  email     String    @unique
  phone     String
  createdAt DateTime  @default(now())
  bookings  Booking[]
}

model Mechanic {
  id        String         @id @default(cuid())
  name      String
  status    MechanicStatus @default(AVAILABLE)
  createdAt DateTime       @default(now())
  bookings  Booking[]
}

model Service {
  id       String    @id @default(cuid())
  name     String
  category String
  bookings Booking[]
}

model Booking {
  id          String        @id @default(cuid())
  customer    Customer      @relation(fields: [customerId], references: [id])
  customerId  String
  mechanic    Mechanic?     @relation(fields: [mechanicId], references: [id])
  mechanicId  String?
  service     Service       @relation(fields: [serviceId], references: [id])
  serviceId   String
  vehicle     String
  status      BookingStatus @default(PENDING)
  amount      Float
  scheduledAt DateTime
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([status])
  @@index([scheduledAt])
}
model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String
  role      String   @default("OPERATIONS")
  createdAt DateTime @default(now())
}